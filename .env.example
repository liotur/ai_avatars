# --- Amdocs AutoX (the provider this project calls) ---
# POST {AUTOX_BASE_URL}/responses?api-version={AUTOX_API_VERSION}
# Headers: api-key, username, application. Never commit real values.
LLM_PROVIDER=autox
AUTOX_KEY=
AUTOX_USERNAME=
AUTOX_BASE_URL=https://chat.autox.corp.amdocs.azr/api/v1/proxy/openai
AUTOX_API_VERSION=2025-03-01-preview
AUTOX_APPLICATION=autox-merged-ui
LLM_MODEL=gpt-4.1-mini

# Optional aliases, used only when the AUTOX_* value above is empty.
# LLM_API_KEY stands in for AUTOX_KEY. USERNAME stands in for AUTOX_USERNAME.

# --- inside the demo container these are preset; dev uses localhost ---
AVATAR_MCP_URL=http://localhost:3001/mcp
AVATAR_API_URL=http://localhost:3000/v1
DATABASE_PATH=./data/avatars.db
CORS_ORIGIN=http://localhost:5173
VITE_AVATAR_API_URL=http://localhost:3000/v1
VITE_ASSISTANT_API_URL=http://localhost:3002/v1

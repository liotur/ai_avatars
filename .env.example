# Copy this file to .env and fill in the first two lines.
# The .env file is never committed.

# Amdocs AutoX. It is reachable from the Amdocs network (VPN) only.
AUTOX_USERNAME=
AUTOX_KEY=

# The model that picks the avatar, writes the answer, and checks it.
# To use another, replace the name below with one from this list that your
# AutoX account offers:
#   gpt-4.1-mini   the default: quick and inexpensive
#   gpt-4.1        stronger, slower
#   gpt-4.1-nano   fastest
#   gpt-4o
#   gpt-4o-mini
LLM_MODEL=gpt-4.1-mini

# ---- Rarely needed ----
# AVATARS_PORT=8090        the port the app is published on by docker compose
# ANSWER_CHECK=off         skip validating each answer before it counts as the answer
# AUTOX_BASE_URL=https://chat.autox.corp.amdocs.azr/api/v1/proxy/openai
# AUTOX_API_VERSION=2025-03-01-preview
# AUTOX_APPLICATION=autox-merged-ui
#
# No access to AutoX? The assistant can use another provider: see docs/LLM.md.

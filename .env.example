# --- required for the assistant ---
LLM_API_KEY=

# Provider is optional when the key prefix is enough (sk-, AIza, sk-or-, …).
# Otherwise set one of: openai, gemini, openrouter, ollama, custom
LLM_PROVIDER=

LLM_MODEL=
LLM_BASE_URL=
LLM_USERNAME=

# --- inside the demo container these are preset; dev uses localhost ---
AVATAR_MCP_URL=http://localhost:3001/mcp
AVATAR_API_URL=http://localhost:3000/v1
DATABASE_PATH=./data/avatars.db
CORS_ORIGIN=http://localhost:5173
VITE_AVATAR_API_URL=http://localhost:3000/v1
VITE_ASSISTANT_API_URL=http://localhost:3002/v1
